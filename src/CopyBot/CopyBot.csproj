<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CopyBot</AssemblyName>
    <RootNamespace>CopyBot</RootNamespace>
    <!-- Single source of truth for the version. Bumped before each release tag. -->
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <UseWindowsForms>false</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NuGetAudit>False</NuGetAudit>
    <Title>$(AssemblyName)</Title>
    <Company>HnZ and SbH Corp.</Company>
    <Copyright>2026 - HnZ and SbH Corp.</Copyright>
    <Authors>HnZ, SbH</Authors>
    <Product>The utility to show who's the boss to some Profs.</Product>
    <Description>The utility to show who's the boss to some known Profs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scripts\install-service.ps1" Link="install-service.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scripts\uninstall-service.ps1" Link="uninstall-service.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    OPTIONAL packaging stage: produces a deployable ZIP of the build output named after
    the version in CopyBot.exe. Never runs during a normal build; invoke explicitly with:
      dotnet build -c Release /t:CreateReleaseZip -p:CreateReleaseZip=true
    or run scripts/package-zip.ps1 directly.
  -->
  <Target Name="CreateReleaseZip"
          Condition="'$(CreateReleaseZip)' == 'true'"
          DependsOnTargets="Build">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\package-zip.ps1&quot; -Source &quot;$(TargetDir.TrimEnd('\'))&quot; -OutputDir &quot;$(MSBuildProjectDirectory)\..\..\dist&quot;" />
  </Target>

</Project>